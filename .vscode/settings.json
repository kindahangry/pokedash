{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enable": true,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true
  },
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.associations": {
    "supabase/functions/**/*.ts": "typescript"
  }
}

